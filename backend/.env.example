# Copy to .env for local development. In AWS these come from Secrets Manager / task env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cw:cw@localhost:5432/cooper?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
# Comma-separated origins allowed by CORS (admin dashboard)
CORS_ORIGINS=http://localhost:5173
# S3-compatible storage
S3_BUCKET=cooper-waters-dev
S3_REGION=ap-southeast-2
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Providers: mock | manual | <real adapter name>
SMS_PROVIDER=mock
# Sign-in codes over WhatsApp (SMS stays the fallback): none | mock | meta
WHATSAPP_PROVIDER=none
# Meta WhatsApp Cloud API (see docs/whatsapp-otp.md)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE=cooper_waters_otp
WHATSAPP_OTP_LANGUAGE=en
PUSH_PROVIDER=mock
# Base64 of a Firebase service account JSON (only when PUSH_PROVIDER=fcm)
FCM_SERVICE_ACCOUNT_B64=
# Shared secret used by the mock cell money provider to sign webhooks
MOCK_CELLMONEY_WEBHOOK_SECRET=dev-webhook-secret
SENTRY_DSN=
LOG_LEVEL=info
# Run BullMQ workers inside the API process (true for local dev; false when a separate worker service runs)
RUN_WORKERS=true
